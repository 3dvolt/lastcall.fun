# DEVNET / localhost only. The app refuses to run against mainnet.
VITE_RPC_URL=https://api.devnet.solana.com
VITE_CLUSTER=devnet
# Optional: defaults to the program id in the SDK IDL
VITE_PROGRAM_ID=
# Printed by `npm run create-collateral` (deployments/devnet.json -> collateralMint)
VITE_COLLATERAL_MINT=
# Public key of the demo feed authority (DEMO_AUTHORITY in the root .env). Used to flag feeds written by anyone else.
VITE_DEMO_AUTHORITY=
# Resolver service (read-only API) and faucet server
VITE_RESOLVER_API=http://localhost:8787
VITE_FAUCET_API=http://localhost:8788
# Trusted resolver public key (resolver service key). Markets resolved by any other key are hidden in the UI.
VITE_RESOLVER_PUBKEY=
