# Public values only (they end up in the browser). The app refuses an RPC that is not the selected network.
VITE_RPC_URL=https://api.devnet.solana.com
VITE_CLUSTER=devnet
# RPC used ONLY for getProgramAccounts (listing markets / finding pools). Defaults to the free public Solana devnet RPC.
VITE_LIST_RPC_URL=
# Optional: defaults to the program id in the SDK IDL
VITE_PROGRAM_ID=
# The collateral token of the markets this app lists (6 decimals)
VITE_COLLATERAL_MINT=

# --- Mainnet (OPTIONAL: leave empty to keep the Mainnet entry of the network dropdown disabled) ---
# Fill ALL of these only after the PRODUCTION program (no demo feed) is deployed on mainnet-beta. Real funds: audit first.
VITE_MAINNET_RPC_URL=
VITE_MAINNET_PROGRAM_ID=
VITE_MAINNET_COLLATERAL_MINT=
