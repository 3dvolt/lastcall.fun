# DEVNET / localhost ONLY. The services refuse mainnet RPCs.
RPC_URL=https://api.devnet.solana.com
# Defaults to the program id baked into the SDK IDL; set after deploying a new program keypair.
PROGRAM_ID=

# Gitignored keypair files (generate with `npm run keys`). NEVER commit these.
DEPLOYER_KEYPAIR=keys/deployer.json
RESOLVER_KEYPAIR=keys/resolver.json
DEMO_AUTHORITY_KEYPAIR=keys/demo-authority.json
FAUCET_KEYPAIR=keys/faucet.json

# Public key of the demo feed authority; the resolver ignores feeds written by anyone else.
DEMO_AUTHORITY=

# Resolver service
PORT=8787
DATA_DIR=data
SAMPLE_INTERVAL_SECS=10
MIN_LIQUIDITY_USD=10000
MAX_STALENESS_SECS=30
# Optional anti-griefing: comma-separated creator pubkeys whose markets the resolver will sample/resolve (default: all)
# ALLOWED_CREATORS=
# Optional: force the evaluation window for all markets (else on-chain resolution_window_secs is used)
# WINDOW_SECS=300

# Faucet HTTP server (devnet test token only)
FAUCET_PORT=8788
FAUCET_MAX_TOKENS=1000
